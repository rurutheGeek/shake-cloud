# メールビューア（stacks/mail-view）の宣言値。秘密値は secrets/ に置き、ここへ書かない。
#
# IMAP のアプリパスワードは Ansible が platform/sops/（mail-view.sops.yaml、
# 無ければ smtp.sops.yaml）から secrets/imap_password へ写し、manage.py が
# 環境変数で Compose へ渡す。IMAP_USERNAME は配備時に .env へ入る。
MAIL_VIEW_PORT=8310
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=shake.notify@gmail.com
MAILBOX=INBOX
MESSAGE_LIMIT=50
CACHE_SECONDS=30
TZ_OFFSET_HOURS=9
TZ=Asia/Tokyo
