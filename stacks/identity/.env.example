COMPOSE_PROJECT_NAME=identity
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.1
POSTGRES_IMAGE=postgres:16-alpine
STORAGE_ROOT=./storage
BIND_ADDRESS=0.0.0.0
# ポータル（cloud-01）の入口。OIDC の redirect URI はここに /auth/callback を足したもの。
CLOUD_PORTAL_URL=http://localhost:8080
# メール送信（任意）。SMTP事業者が決まったら埋める。正本は SOPS の smtp.sops.yaml で、
# 配備が .env のこの行へ写す。空なら招待リンクはファイル保存だけになる。
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# starttls（587）か ssl（465）か plain。省略するとポートから決める。
# SMTP_SECURITY=starttls
# 管理者（akadmin）の復旧先。省略すると SMTP_FROM を使う。
# ADMIN_EMAIL=
