# Vaultwarden スタックの宣言値。秘密値は secrets/ に置き、ここへ書かない。
#
# SSO のクライアント秘密値は identity の oidc-vaultwarden.json を Ansible が
# secrets/oidc_client.json へ写し、manage.py が環境変数で Compose へ渡す。
STORAGE_ROOT=/srv/services/vaultwarden
VAULTWARDEN_PORT=8222
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=false
TZ=Asia/Tokyo
