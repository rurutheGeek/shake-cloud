# Homarr スタックの宣言値。秘密値は secrets/ に置き、ここへ書かない。
#
# 入口の名前が決まったら BASE_URL を HTTPS の名前にする（N05）。
BASE_URL=http://localhost:7575
BIND_ADDRESS=127.0.0.1
HOMARR_PORT=7575
STORAGE_ROOT=/srv/services/homarr

# OIDC。identity 側のクライアントを作ったあとに有効化する。
# AUTH_PROVIDERS=credentials,oidc
# AUTH_OIDC_ISSUER=https://auth.apextox.dpdns.org/application/o/homarr/
# AUTH_OIDC_CLIENT_ID=homarr
AUTH_OIDC_CLIENT_NAME=Authentik

# 設定反映（configure.py）が使う値。
HOMARR_ADMIN_USERNAME=admin
BOARD_NAME=home
BOARD_TITLE=Shake Lab
APPS_FILE=apps.json
ADMIN_GROUP=admins
LOCALE=ja
