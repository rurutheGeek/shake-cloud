{
  "manifest_version": 3,
  "name": "ポケモン翻訳",
  "version": "0.1.0",
  "description": "ポケモン用語を公式名に固定して、見ているページを対訳表示する。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "このページを翻訳（Alt+T）"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      }
    }
  }
}
