# Literal values only; no shell expansions. Defaults match media-01's data disk.
# 秘密値はここに書かず、manage.py init が secrets/ へ生成する（PIN は上流未対応。
# 詳細は README.md）。
STORAGE_ROOT=/srv/media-stack/storage
LIBRARY_ROOT=/srv/media-stack/library
TZ=Asia/Tokyo
MEDIA_UID=33
MEDIA_GID=33
LOCALSEND_PORT=53317
LOCALSEND_ADMIN_PORT=53318
LOCALSEND_DEVICE_NAME=media-01
# イメージ。digest は compose.lock.yaml が固定する。
LOCALSEND_IMAGE=ghcr.io/linychuo/localsend-hub:1.0.10
