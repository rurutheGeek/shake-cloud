<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>shake_print</id>
	<name>印刷</name>
	<summary>CUPS中継（キュー ts8430）へファイルを送る</summary>
	<description><![CDATA[ファイル一覧の「…」メニューに「印刷」を追加します。PDF・画像（PNG/JPEG）・テキストを、services-01 の CUPS 中継（キュー ts8430）へ送ります。印刷APIはトークン認証で、Nextcloud のホストからのみ受け付けます。]]></description>
	<version>1.0.0</version>
	<!-- PHPクラスの名前空間。宣言が無いと Nextcloud は ucfirst した
	     OCA\Shake_print を探し、OCA\ShakePrint と一致せず二重includeになる。 -->
	<namespace>ShakePrint</namespace>
	<licence>agpl</licence>
	<author>Shake Lab</author>
	<category>files</category>
	<dependencies>
		<nextcloud min-version="30" max-version="33"/>
		<php min-version="8.1"/>
	</dependencies>
</info>
