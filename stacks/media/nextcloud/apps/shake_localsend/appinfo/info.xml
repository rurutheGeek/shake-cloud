<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>shake_localsend</id>
	<name>LocalSendで送る</name>
	<summary>同じLANの端末へLocalSendでファイルを送る</summary>
	<description><![CDATA[ファイル一覧の「…」メニューに「LocalSendで送る」を追加します。media-01の送信APIが同じLANのLocalSend端末を探し、選んだ端末へファイルを送ります。送り先の端末ではLocalSendアプリを開いて、受信の確認を押してください。]]></description>
	<version>1.0.5</version>
	<!-- PHPクラスの名前空間。宣言が無いと Nextcloud は ucfirst した
	     OCA\Shake_localsend を探し、OCA\ShakeLocalSend と一致せず二重includeになる。 -->
	<namespace>ShakeLocalSend</namespace>
	<licence>agpl</licence>
	<author>Shake Lab</author>
	<category>files</category>
	<dependencies>
		<nextcloud min-version="30" max-version="33"/>
		<php min-version="8.1"/>
	</dependencies>
</info>
