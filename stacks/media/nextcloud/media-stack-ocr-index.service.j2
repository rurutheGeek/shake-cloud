[Unit]
Description=Index the text in Nextcloud images (ocr_search)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# 既存サービスの邪魔をしないよう、occ側の優先度も下げる（認識本体は
# cpus: 2・mem_limit: 1g のocrコンテナが行う）。
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 {{ project_dir }}/media/nextcloud/manage.py ocr-index --max-runtime {{ nextcloud_ocr_index_max_runtime }}
