# Literal values only; no shell expansions. Defaults match media-01's data disk.
# 秘密値はここに書かず、manage.py init が secrets/ へ生成する。
STORAGE_ROOT=/srv/media-stack/storage
LIBRARY_ROOT=/srv/media-stack/library
TZ=Asia/Tokyo
# Nextcloud の入口。前段の HTTPS 入口（N05）ができるまで 127.0.0.1 だけに公開する。
BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=8080
# 初回起動時だけ使う管理者。パスワードは secrets/nextcloud_admin_password に置く。
NEXTCLOUD_ADMIN_USER=admin
# ブラウザー・スマホ・CalDAV クライアントが使う名前を空白区切りで。IP も書ける。
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1
# イメージ。digest は compose.lock.yaml が固定する。
POSTGRES_IMAGE=postgres:17-alpine
NEXTCLOUD_IMAGE=nextcloud:33-apache
REDIS_IMAGE=redis:7-alpine
