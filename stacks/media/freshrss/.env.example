# Literal values only; no shell expansions. Defaults match media-01's data disk.
STORAGE_ROOT=/srv/media-stack/storage
TZ=Asia/Tokyo
FRESHRSS_PORT=8082
FRESHRSS_IMAGE=freshrss/freshrss:latest
# 15分間隔。動的更新ではなく定期取得なので、短すぎても意味がない。
FRESHRSS_CRON_MIN=2,17,32,47
# 公開URL（Caddy が TLS を終端する）。OIDC の戻り先もこの名前になる。
FRESHRSS_BASE_URL=https://freshrss.apextox.dpdns.org
# 最初のユーザー。Authentik の preferred_username と一致させる。既定ユーザーは管理者。
FRESHRSS_DEFAULT_USER=akadmin
FRESHRSS_OIDC_PROVIDER_METADATA_URL=https://auth.apextox.dpdns.org/application/o/freshrss/.well-known/openid-configuration
# データ領域の所有者。Debian の www-data は 33:33。
MEDIA_UID=33
MEDIA_GID=33
