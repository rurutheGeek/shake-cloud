# Literal values only; no shell expansions. Defaults match media-01's data disk.
STORAGE_ROOT=/srv/media-stack/storage
CLIENT_BACKUP_ROOT=/srv/media-stack/client-backups
TZ=Asia/Tokyo
# クライアントは Caddy（Forward Auth）を通せないため、この LAN アドレスへ
# 直接つなぐ。Ansible は inventory の ansible_host を書く。
BIND_ADDRESS=192.168.10.101
# Web UI（Caddy の中継先）とクライアントの入口。35623/UDP は LAN 内の自動発見。
URBACKUP_WEB_PORT=55414
URBACKUP_CLIENT_PORT=55413
URBACKUP_BROADCAST_PORT=35623
# バックアップポータル（https://backup.apextox.dpdns.org の中継先）。
PORTAL_PORT=55416
# コンテナ内 urbackup ユーザーの uid/gid。HDD 側 NFS の anonuid と揃える
# （platform/ansible/roles/pve_bulk_storage）。
URBACKUP_UID=101
URBACKUP_GID=101
URBACKUP_IMAGE=uroni/urbackup-server:2.5.x
