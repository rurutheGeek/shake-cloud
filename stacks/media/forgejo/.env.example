# Literal values only; no shell expansions. Defaults match media-01.
# STORAGE_ROOT/forgejo は HDD ボリュームの bind（group_vars/media.yml の media_bulk_binds）。
STORAGE_ROOT=/srv/media-stack/storage
TZ=Asia/Tokyo
FORGEJO_PORT=8083
# LTS の系列。版は compose.lock.yaml の digest で固定する。
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15
FORGEJO_MEMORY_LIMIT=512m
FORGEJO_MIRROR_INTERVAL=8h
# 公開URL（Caddy が TLS を終端する）。OIDC の戻り先もこの名前になる。
FORGEJO_ROOT_URL=https://forgejo.apextox.dpdns.org/
FORGEJO_OIDC_DISCOVERY_URL=https://auth.apextox.dpdns.org/application/o/forgejo/.well-known/openid-configuration
# ミラーを持つ組織。
FORGEJO_ARCHIVE_ORG=archive
# データ領域の所有者。イメージの git ユーザー。
FORGEJO_UID=1000
FORGEJO_GID=1000
