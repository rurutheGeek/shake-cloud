# leo_rtc ライブ配信の配備設定。値は platform/sops/eufy-security.sops.yaml が正本で、
# Ansible がここへ流し込む。手で置く場合は 0600 で。
STORAGE_ROOT=/srv/eufy-leo-rtc
TZ=Asia/Tokyo
# 機器の識別子（クラウド応答の p2p_did / p2p_license と、SN・account）
EUFY_SN=
EUFY_DID=
EUFY_LICENSE=
EUFY_ACCOUNT=
EUFY_CONTACT=
# セッション後の待ち（秒）
LEO_IDLE_WAIT=120
LEO_DEMAND_WAIT=15
# 映像が止まってから開始コマンド(1003)を再送し、同一セッションで流し直す。
# VIDEO_IDLE は再送に与える猶予（これを超えるとセッションを切って張り直す）。
LEO_VIDEO_IDLE=4
LEO_WAKE_WAIT=25
LEO_1003_RETRY=1
# 映像停止後も同一プロセスで新しい calls を送り、映像復帰を粘る秒数（0 で無効）
LEO_REARM_LIMIT=0
LEO_REARM_WAIT=15
# アプリ実測どおり ICE-CONTROLLED（0x8029）で要求する（既定 1）。0 で従来の
# CONTROLLING（カメラが 400/487 を返し、KCP チャネルが確立しない）。
LEO_ICE_CONTROLLED=1

# 実験: アプリの平文レポート（90ce）を自前の seq で送る（空なら無効）
LEO_APP_REPORT=
LEO_REPORT_FILE=
