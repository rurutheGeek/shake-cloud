# leo_rtc 開発用の参照雛形。実値は .env（0600）か環境変数へ置き、Git へ入れない。
# DID は機器のクラウド応答の p2p_did、LICENSE は p2p_license。
EUFY_SN=T8172P102603060C
EUFY_DID=
EUFY_LICENSE=
# account はクラウドの user_id（call JSON の account 計算に使う。空でも wake は確認済み）。
EUFY_ACCOUNT=
# 未指定なら discover の server_addr を使う。
EUFY_SIGNAL_HOST=
EUFY_SIGNAL_PORT=5062
