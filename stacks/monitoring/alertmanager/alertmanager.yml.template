# Alertmanager。Prometheus のアラートを既存の Gmail SMTP でメール通知する。
# プレースホルダは manage.py が .env の値で描画する。
global:
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_USERNAME}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  smtp_require_tls: ${SMTP_REQUIRE_TLS}

route:
  receiver: email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  # Watchdog は常時 firing。外部の dead man's switch だけへ送る（メールには流さない）。
  routes:
    - matchers:
        - alertname = Watchdog
      receiver: deadman
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1h

receivers:
  - name: email
    email_configs:
      - to: '${ALERT_EMAIL}'
        send_resolved: true
  # WATCHDOG_PING_URL が空なら manage.py が webhook_configs を外す（no-opの宛先として残す）。
  - name: deadman
    # deadman:start
    webhook_configs:
      - url: '${WATCHDOG_PING_URL}'
        send_resolved: false
    # deadman:end
