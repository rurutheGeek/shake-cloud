# 監視スタックの宣言値。秘密値は secrets/ に置き、ここへ書かない。
#
# 入口の名前が決まったら BASE_URL を HTTPS の名前にする。
GRAFANA_ROOT_URL=https://grafana.apextox.dpdns.org
BIND_ADDRESS=127.0.0.1
STORAGE_ROOT=/srv/monitoring

# Prometheus の保持期間。データディスクの実使用を見て調整する。
PROMETHEUS_RETENTION=15d

# Proxmox の読み取り専用トークン（pve-exporter が使う）。
# 値は secrets/pve_token に置く。ユーザー名とトークン名だけここへ書く。
PVE_USER=monitoring@pve
PVE_TOKEN_NAME=monitoring

# UPS（ProxmoxホストのNUTサーバー）。
NUT_SERVER=192.168.10.126
NUT_USERNAME=monitor

# PeaNUT（HomarrのUPSウィジェット用）。パスワードは secrets/peanut_web_password。
PEANUT_WEB_USERNAME=admin

# OIDC。identity に grafana クライアントを作った後に有効化する。
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_AUTH_URL=https://auth.apextox.dpdns.org/application/o/authorize/
GRAFANA_OIDC_TOKEN_URL=https://auth.apextox.dpdns.org/application/o/token/
GRAFANA_OIDC_API_URL=https://auth.apextox.dpdns.org/application/o/userinfo/

# アラートの宛先。SMTP の値は Ansible が smtp.sops.yaml から .env へ写す。
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
