{
  "title": "ゲームサーバー使用量",
  "description": "ゲームVMの全体（VM全体）と、実行中ゲームのセッション別使用量。セッションはゲームの起動中だけ表示され、終了すると時間とともに消えます。",
  "uid": "shakelab-game",
  "tags": ["game", "usage", "ゲーム"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Shake Lab overview",
      "url": "/d/shakelab-overview",
      "icon": "external link",
      "targetBlank": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "title",
        "label": "タイトル",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(game_session_info, title)",
          "refId": "title"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "session",
        "label": "セッション",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(game_session_info, session_id)",
          "refId": "session"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ゲームVM 応答",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"game\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "未接続",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "停止", "index": 0 },
                "1": { "text": "接続中", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "VM全体 CPU",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_cpu_percent",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "VM全体 メモリ",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_memory_bytes",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8589934592 },
              { "color": "red", "value": 10737418240 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU 使用率",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_gpu_utilization_percent",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "GPU 温度",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_gpu_temperature_celsius",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "実行中セッション",
      "description": "いま動いているゲームの数。ゲームを終了すると減ります。",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(game_session_info) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU（VM全体 / セッション）",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_cpu_percent",
          "legendFormat": "VM全体"
        },
        {
          "refId": "B",
          "expr": "game_session_cpu_percent{title=~\"$title\",session_id=~\"$session\"}",
          "legendFormat": "{{title}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "メモリ（VM全体 / セッション）",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_memory_bytes",
          "legendFormat": "VM全体"
        },
        {
          "refId": "B",
          "expr": "game_session_memory_bytes{title=~\"$title\",session_id=~\"$session\"}",
          "legendFormat": "{{title}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ディスク I/O",
      "description": "セッション別は Netdata の cgroup I/O 実測値。VM全体は全ディスク合計。",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_disk_read_bytes_per_second",
          "legendFormat": "VM全体 読込"
        },
        {
          "refId": "B",
          "expr": "game_host_disk_write_bytes_per_second",
          "legendFormat": "VM全体 書込"
        },
        {
          "refId": "C",
          "expr": "game_session_disk_read_bytes_per_second{title=~\"$title\",session_id=~\"$session\"}",
          "legendFormat": "{{title}} 読込"
        },
        {
          "refId": "D",
          "expr": "game_session_disk_write_bytes_per_second{title=~\"$title\",session_id=~\"$session\"}",
          "legendFormat": "{{title}} 書込"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ネットワーク（VM全体）",
      "description": "現在の Netdata は cgroup のネットワーク値を収集しないため、セッション別は表示しません（推定値で埋めません）。",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_host_network_received_kilobits_per_second",
          "legendFormat": "VM全体 受信"
        },
        {
          "refId": "B",
          "expr": "game_host_network_sent_kilobits_per_second",
          "legendFormat": "VM全体 送信"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Kbits",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "セッション一覧（実行中）",
      "description": "いま動いているゲームだけを表示します。ゲームを終了すると行は消えます。CPUはVM全体0〜100%へ正規化した値。",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "game_session_cpu_percent{title=~\"$title\",session_id=~\"$session\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "game_session_memory_bytes{title=~\"$title\",session_id=~\"$session\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "game_session_disk_read_bytes_per_second{title=~\"$title\",session_id=~\"$session\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "game_session_disk_write_bytes_per_second{title=~\"$title\",session_id=~\"$session\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "time() - game_session_started_at_seconds{title=~\"$title\",session_id=~\"$session\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true,
              "feature": true
            }
          }
        },
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "game_session_info": true,
              "Value #F": true
            },
            "renameByName": {
              "session_id": "セッションID",
              "owner_id": "所有者ID",
              "title_id": "タイトルID",
              "title": "タイトル",
              "game_session_cpu_percent": "CPU %",
              "Value #A": "CPU %",
              "game_session_memory_bytes": "メモリ",
              "Value #B": "メモリ",
              "game_session_disk_read_bytes_per_second": "読込",
              "Value #C": "読込",
              "game_session_disk_write_bytes_per_second": "書込",
              "Value #D": "書込",
              "Value": "稼働時間",
              "Value #E": "稼働時間"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "メモリ" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "読込" },
            "properties": [{ "id": "unit", "value": "Bps" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "書込" },
            "properties": [{ "id": "unit", "value": "Bps" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "稼働時間" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU %", "desc": true }]
      }
    }
  ]
}
