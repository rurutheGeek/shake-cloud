          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "調べられなかった",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(shakecloud_image_scan_error == 1) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "最後の点検",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shakecloud_image_scan_last_success_timestamp_seconds * 1000",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "通知中のアラート（脆弱性）",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=~\"Image.*\",alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "group": true,
              "Value": true,
              "alertstate": true,
              "reason": true,
              "package": true,
              "id": true,
              "installed": true,
              "latest": true,
              "fixed": true,
              "status": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "image": 2,
              "runtime": 3,
              "source": 4
            },
            "renameByName": {
              "severity": "重さ",
              "alertname": "アラート",
              "image": "イメージ",
              "runtime": "ランタイム",
              "source": "定義"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "重さ"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "warning": {
                        "text": "注意",
                        "color": "orange",
                        "index": 0
                      },
                      "info": {
                        "text": "情報",
                        "color": "blue",
                        "index": 1
                      },
                      "critical": {
                        "text": "重大",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "重大な脆弱性（修正版あり）の一覧",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shakecloud_image_vulnerability",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "group": true,
              "Value": true
            },
            "indexByName": {
              "image": 0,
              "id": 1,
              "package": 2,
              "installed": 3,
              "fixed": 4,
              "source": 5
            },
            "renameByName": {
              "image": "イメージ",
              "id": "CVE",
              "package": "パッケージ",
              "installed": "入っている版",
              "fixed": "修正版",
              "source": "定義"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "イメージ",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "ランタイムの版（PHP・Node.js・Python）",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shakecloud_image_runtime",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "group": true,
              "Value": true
            },
            "indexByName": {
              "status": 0,
              "image": 1,
              "runtime": 2,
              "installed": 3,
              "latest": 4,
              "source": 5
            },
            "renameByName": {
              "status": "状態",
              "image": "イメージ",
              "runtime": "ランタイム",
              "installed": "入っている版",
              "latest": "系列の最新版",
              "source": "定義"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "状態"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "security": {
                        "text": "セキュリティ修正あり",
                        "color": "red",
                        "index": 0
                      },
                      "eol": {
                        "text": "サポート切れ",
                        "color": "orange",
                        "index": 1
                      },
                      "update": {
                        "text": "更新あり",
                        "color": "yellow",
                        "index": 2
                      },
                      "current": {
                        "text": "最新",
                        "color": "green",
                        "index": 3
                      },
                      "unknown": {
                        "text": "不明",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "状態",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "重大な脆弱性とセキュリティ修正待ちの推移",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shakecloud_image_critical_vulnerabilities)",
          "legendFormat": "重大な脆弱性"
        },
        {
          "refId": "B",
          "expr": "count(shakecloud_image_runtime{status=\"security\"} == 1) or vector(0)",
          "legendFormat": "ランタイムのセキュリティ修正待ち"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "調べられなかったイメージ",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shakecloud_image_scan_error == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "group": true,
              "Value": true
            },
            "indexByName": {
              "image": 0,
              "reason": 1,
              "source": 2
            },
            "renameByName": {
              "image": "イメージ",
              "reason": "理由",
              "source": "定義"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "イメージ",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ]
}
