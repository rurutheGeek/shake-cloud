# stacks/shake-web の入力。実物の .env は role（platform/ansible/roles/shake_web）
# が SOPS の秘密値から描画する。ここは項目の一覧と説明だけ。
# **実際のパスワードは書かない。**

# データディスク上の保存先。ソース・静的物・ログ・証明書をここに置く。
STORAGE_ROOT=/srv/shake-web

# ポケモン系 PostgreSQL（apps-01）。旧ホストでは host.docker.internal だった。
DB_HOST=pkdb.apextox.dpdns.org
DB_PORT=5432
DB_USER=pkdb_reader
DB_NAME=sleepy_pkdb
DB_PASSWORD=secret

# セッション / WebAuthn チャレンジ署名鍵（HMAC）。
SHAKE_SECRET=secret
IKURA_SECRET=secret

# shake_web サイト用 DB（quiz_rankings 等）。
SHAKEWEB_DB_HOST=pkdb.apextox.dpdns.org
SHAKEWEB_DB_PORT=5432
SHAKEWEB_DB_NAME=shakeweb
SHAKEWEB_DB_READER_USER=shakeweb_reader
SHAKEWEB_DB_READER_PASSWORD=secret
SHAKEWEB_DB_EDITOR_USER=shakeweb_editor
SHAKEWEB_DB_EDITOR_PASSWORD=secret

# pkhack（ポケモンクイズ）専用 DB。
PKHACK_DB_HOST=pkdb.apextox.dpdns.org
PKHACK_DB_PORT=5432
PKHACK_DB_NAME=pkhack
PKHACK_DB_READER_USER=pkhack_reader
PKHACK_DB_READER_PASSWORD=secret
PKHACK_DB_EDITOR_USER=pkhack_editor
PKHACK_DB_EDITOR_PASSWORD=secret

# 各リポジトリの追う ref。検証中はブランチ、確定後は main。
SHAKE_WEB_REF=main
PKHACK_REF=main
ALEXA_REF=main
AYAHUYA_REF=main
