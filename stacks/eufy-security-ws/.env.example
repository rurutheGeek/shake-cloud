# eufy-security-ws。実値は配備時に platform/sops/eufy-security.sops.yaml から
# .env へ写す（0600）。Git へ秘密値を置かない。
STORAGE_ROOT=/srv/services/eufy-security-ws
TZ=Asia/Tokyo
EUFY_COUNTRY=JP
EUFY_TRUSTED_DEVICE_NAME=shake-cloud
EUFY_EVENT_DURATION_SECONDS=10
# カメラの「シリアル:IP」。クラウドが古いIPを返す間もローカルP2Pを試せる。
EUFY_STATION_IP_ADDRESSES=
# 1 にするとトークンや鍵がログへ平文で出る。調査の間だけ使い、終わったら空に戻す。
EUFY_DEBUG=
