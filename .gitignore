.env
secrets/
storage/
library/
backups/
__pycache__/
.venv/
compose.integrations.yaml
compose.https.yaml
runtime/
.survey/
# 構成管理者の手元にだけ置く平文。VMのログインパスワードなど。
.local/

platform/ansible/inventory.ini
platform/ansible/pve.ini
platform/ansible/monitor.ini
platform/ansible/seed.ini
platform/ansible/netbox.env
platform/awx/controller.yml
platform/awx/context/

stacks/docs/site/
stacks/music-tools/tags.local.json

!stacks/music-tools/compose.lock.yaml

.hub-venv/
RUNNING.md
library*/
**/compose.sso.yaml
docs/downloads/*.crt
*.log

# Terraform / OpenTofu。.terraform.lock.hcl は版を固定するため追跡する。
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log

# 鍵・資格情報。age の秘密鍵はリポジトリの外 (~/.config/sops/age/) に置く。
age-key.txt
*.agekey
kubeconfig
*.kubeconfig
talosconfig

# SOPS。既定では platform/sops/ の全てを除外し、暗号化済みファイルと
# 設定・例だけを明示的に追跡する。復号した平文を誤って追加できない。
platform/sops/*
!platform/sops/*.sops.yaml
!platform/sops/*.example

# shakecloud CLI のビルド成果物（go build を cloud/cli で実行したときの名前）。
/cloud/cli/cli
/cloud/cli/shakecloud
/cloud/provider/provider
/cloud/provider/terraform-provider-shakecloud

# ルータ用 OpenWrt イメージのビルド作業場所と成果物。宣言は openwrt.yaml で、
# dist/ は build.sh が再生成する。Terraform の router モジュールが取り込む。
platform/openwrt/.build/
platform/openwrt/dist/
