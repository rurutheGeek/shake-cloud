# DHCP と IPv6。IPv4 は dnsmasq が 192.168.10.20〜.99 を配る。
# **.2〜.19 はネットワーク機器・常時稼働サーバの帯**（DHCP プールの外）。
# IPv6 は PD がないため、RA と DHCPv6 は odhcpd の relay で中継し、近隣代理は
# ndppd が受け持つ（/etc/ndppd.conf）。Aterm の ND Proxy と同じ役割。
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	# **自分のドメインは rebind protection から除外する。**
	# `*.apextox.dpdns.org` は Cloudflare の公開レコードが LAN の IP
	# （192.168.10.x）を指す。rebind protection は公開 DNS が返すプライベート
	# アドレスを捨てるので、除外しないと **LAN からサービス名が一切引けなく
	# なる**（2026-09-20 の切替後に実際に全滅した。Aterm は捨てていなかった）。
	# 正本は platform/terraform/dns.yaml のゾーン。
	list rebind_domain 'apextox.dpdns.org'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	# **NetBox 由来の予約（dhcp-host）を読むディレクトリ。**
	# tools/netbox-dhcp-sync.py が netbox-reservations.conf を書き、
	# dnsmasq を再読込する。手で編集しない（正本は NetBox の reserved IP）。
	option confdir '/etc/dnsmasq.d'
	# **DNS の窓口は AdGuard Home（:53）。** dnsmasq の DNS は 5353 へ移し、
	# DHCP とローカル名（*.lan・リース名）だけを担当する。外部クエリは
	# AdGuard（127.0.0.1#53）へ転送する。ISP の DNS は使わない。
	option port '5353'
	option noresolv '1'
	list server '127.0.0.1#53'

# 固定アドレス（.2〜.19 の機器帯）は **NetBox が正本**。
# 機器の宣言は platform/netbox/devices.yaml、dnsmasq への反映は
# tools/netbox-dhcp-sync.py pull（/etc/dnsmasq.d に生成）。
# UCI に `config host` を手書きしない（二重管理になる）。
config dhcp 'lan'
	option interface 'lan'
	# 機器帯 .2〜.19 を空けて .20〜.99 を配る。
	option start '20'
	option limit '80'
	# ルータ自身を DNS として案内する（odhcpd 用）。
	# **注: いま IPv6 端末には届かない。** JPNE の上流 RA には RDNSS が無く、
	# odhcpd の relay は「上流 RA にある RDNSS を書き換える」方式のため、
	# 書き換える元が無い。LAN 端末は DHCPv4 で 192.168.10.1（AdGuard）を使う。
	# 将来 ISP が RDNSS を載せれば、この1行で AdGuard へ書き換わる。
	list dns '192.168.10.1'
	# **dnsmasq の DHCP 応答に DNS サーバー（option 6）を明示する。**
	# この構成では既定の option 6 が配られない（実測: Offer に 1/3/15/28/51/54
	# はあるが 6 が無い。2026-09-20、再起動後のリース更新で発覚）。これが無いと
	# DHCP で DNS をもらう端末（スマホ等）は名前解決できず「インターネットなし」
	# になる。AdGuard の 192.168.10.1 を配る。
	list dhcp_option '6,192.168.10.1'
	option leasetime '12h'
	option dhcpv4 'server'
	option dhcpv6 'relay'
	option ra 'relay'
	# **ndp は ndppd に任せる（disabled）。** odhcpd の ndp relay は端末が
	# アドレスを作る瞬間（DAD）を捕まえて /128 経路を入れる方式で、一度
	# 取りこぼすと二度と学習の機会が来ない。ルータを再起動しても端末は
	# アドレスを作り直さないため、MAC 由来の固定アドレス（サーバ類）は
	# 再起動のたびに IPv6 を失う（2026-09-20 に実機で再現）。代理応答は
	# /etc/ndppd.conf、転送用の経路は
	# /etc/hotplug.d/iface/91-lan-prefix-route が受け持つ。
	option ndp 'disabled'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'

# relay の master は上流（wan6）側に付ける。LAN は relay 側。
#
# **master には `master '1'` だけでなく、中継する 3 つを relay にする必要が
# ある。** odhcpd のモードは上流・下流それぞれのインターフェースごとに持つ
# ので、片側（lan）だけ relay にしても中継は始まらない。2026-09-20 の切替後、
# これが欠けていて LAN へ RA が 1 つも出ず、端末が IPv6 を取れなかった。
config dhcp 'wan6'
	option interface 'wan6'
	option ignore '1'
	option master '1'
	option ra 'relay'
	option dhcpv6 'relay'
	# lan 側と同じ理由で ndppd に任せる。
	option ndp 'disabled'
