#!/bin/sh
# Git 管理の UCI 設定を /etc/config へ反映する。
#
#   /etc/shakecloud/apply          # 反映してサービスを再読込する
#   /etc/shakecloud/apply boot     # 初回起動用（init が起動前に読むので再読込しない）
#
# 通常の更新はイメージを作り直して VM のディスクを入れ替える。
# 稼働中のルータへ直接反映するときは、このスクリプトと config/ を
# scp してから実行し、必要なら reboot する（docs/operations/router.md）。
set -eu

for file in /etc/shakecloud/config/*; do
	[ -f "$file" ] || continue
	cp "$file" "/etc/config/$(basename "$file")"
done

if [ "${1:-}" = boot ]; then
	logger -t shakecloud "UCI config applied at first boot"
	exit 0
fi

/etc/init.d/network reload
/etc/init.d/dnsmasq restart
/etc/init.d/odhcpd restart
/etc/init.d/firewall reload
logger -t shakecloud "UCI config applied; services reloaded"
