# terraform.tfvars へコピーして実値を入れる。tfvars は .gitignore 対象。
# **すべて棚卸し（platform/ansible/survey-pve.yml）の出力から転記する。**
# 秘密値はここに書かない。接続情報は SOPS 経由の環境変数で渡す。

proxmox_node_name = "pve"
vm_datastore_id   = "local-lvm"

# PVE 8.4 以降なら import。使えない版では "iso" にしてファイル名を .img にする。

# 00-bootstrap の `cloud_image_file_ids` 出力から転記する。取得そのものは
# 特権が要るため 00-bootstrap（root@pam）が担当する。
image_file_id = "local:import/debian-13-genericcloud-amd64-<日付>-<番号>.qcow2"

network_bridge = "vmbr0"
# VLAN を使わないなら指定しない
# network_vlan_id = 20

# 基盤VMが載るネットワーク。台帳としての登録で、ここからは採番しない。
management_prefix = "192.0.2.0/24"

# 実際の採番元。**Prefix 全体から採番するとゲートウェイまで対象になる**ので、
# ルータのDHCP配布範囲・ゲートウェイ・既存の固定機器を避けた範囲で限定する。
management_range_start = "192.0.2.201/24"
management_range_end   = "192.0.2.249/24"
# cloud_prefix    = "198.51.100.0/24"

gateway     = "192.0.2.1"
dns_servers = ["192.0.2.1"]
# dns_domain = "home.arpa"

vm_username = "debian"

admin_ssh_public_keys = [
  "ssh-ed25519 AAAA...REPLACE admin@management-pc",
]

# 開発VMには本人の鍵だけを足す。鍵は共有しない。
host_ssh_public_keys = {
  "dev-a" = ["ssh-ed25519 AAAA...REPLACE user-a@laptop"]
  "dev-b" = ["ssh-ed25519 AAAA...REPLACE user-b@laptop"]
}
