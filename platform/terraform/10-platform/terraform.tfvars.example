# **10-platform に terraform.tfvars は要りません。**
#
# 以前ここにあった値は、性質ごとに正本へ移しました。tfvars は gitignore 対象
# なので、それを持たない作業機で plan を打つと「宣言に無い＝消す／剥がす」
# という差分が出ていました。実際にイメージを消す plan が出たため、全部移しました。
#
# | もとの変数 | いまの正本 | 性質 |
# | --- | --- | --- |
# | proxmox_node_name / vm_datastore_id / network_bridge | site.yaml | 実測 |
# | management_prefix / gateway / dns_servers | site.yaml | 実測 |
# | management_range_* / cloud_* | network.yaml | 決めごと |
# | admin_ssh_public_keys / host_ssh_public_keys | access.yaml | 決めごと（公開鍵） |
# | image_file_id | images.yaml から組み立て | 決めごと |
#
# site.yaml は tools/site-yaml.py --api が実機から生成します。手で書きません。
#
# 残る変数はすべて既定値を持つので、上書きしたいときだけ tfvars を作ります。
#
# image_name          = "debian13"     # 既定は images.yaml の default_image
# network_vlan_id     = 20             # VLAN分離後に指定する
# dns_domain          = "home.arpa"
# vm_username         = "debian"
# netbox_site_name    = "Homelab"
# netbox_cluster_name = "k11"
