[Unit]
Description=Fetch the UBSLEEPY source and restart the bot when it changed
Documentation=https://docs.apextox.dpdns.org/operations/ubsleepy/
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ ubsleepy_project_dir }}
ExecStart=/usr/bin/python3 manage.py update
