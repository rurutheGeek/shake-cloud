#!/usr/bin/env python3
"""Remember which Proxmox guests were running and put them back on boot.

`pve-guests.service` starts only guests with onboot=1, so a VM that was running
when the host was powered off does not come back by itself. This records the
exact set that was running and restores it after pve-guests has run.

    shakecloud-guests save            # write the running set (periodic snapshot)
    shakecloud-guests save-shutdown   # write the running set; mark it a deliberate host shutdown
    shakecloud-guests restore         # start the saved set, skipping those already up

`save` runs every minute (hard power loss leaves the last snapshot). Because the
saved set follows reality, a guest that was off stays off.

The minute between periodic snapshots is the gap a hard hang falls into:
stopping game1 hangs the host within seconds through its iGPU passthrough, so
the last snapshot still says "running" and a plain restore would start a guest
the operator had just stopped by hand. `restore` therefore also reads the
Proxmox task log, which timestamps every power task, and skips a guest whose
newest power task after the snapshot was a stop or a shutdown. A guest that was
stopped and started again keeps its start, so the restored set is what was
really up when the host died.

`save-shutdown` runs instead of the periodic `save`, just before pve-guests
stops the guests on a deliberate host shutdown/reboot, and also drops a marker
file. pve-guests' stopall then sends every one of those guests a `qmshutdown`
on its way down -- which the task log cannot tell apart from an operator
stopping that one guest by hand. Without the marker, `restore` would read that
qmshutdown and wrongly skip the entire saved set (see docs/operations/power.md
for the incident that exposed this). With the marker present, `restore` trusts
the saved set outright instead of re-deriving it from the task log, and then
consumes the marker so a later hard power loss still falls back to the task-log
check.
"""
import pathlib
import re
import subprocess
import sys

STATE = pathlib.Path('/var/lib/shakecloud/guests-running')
CLEAN_SHUTDOWN = pathlib.Path('/var/lib/shakecloud/clean-shutdown')
# Completed tasks land in `index`; `active` holds the ones still running.
TASK_LOGS = (
    pathlib.Path('/var/log/pve/tasks/index'),
    pathlib.Path('/var/log/pve/tasks/active'),
)
# UPID:<node>:<pid>:<pstart>:<starttime hex>:<type>:<id>:<user>:
UPID = re.compile(
    r'UPID:[^:]*:[^:]*:[^:]*:(?P<start>[0-9A-Fa-f]+):(?P<action>[a-z]+):(?P<vmid>[^:]*):')
STOPPING = {'qmstop', 'qmshutdown', 'vzstop', 'vzshutdown'}
POWER = STOPPING | {'qmstart', 'qmreboot', 'qmreset', 'vzstart'}


def running():
    result = subprocess.run(['qm', 'list'], capture_output=True, text=True, check=True)
    guests = []
    # qm list columns are: VMID NAME STATUS MEM(MB) BOOTDISK(GB) PID.
    for line in result.stdout.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 3 and parts[2] == 'running':
            guests.append(parts[0])
    return guests


def last_power_action(since):
    """Newest power task per guest started after `since` (epoch seconds)."""
    newest = {}
    for path in TASK_LOGS:
        try:
            text = path.read_text(errors='replace')
        except OSError:
            continue
        for line in text.splitlines():
            match = UPID.match(line.strip())
            if match is None or match.group('action') not in POWER:
                continue
            started = int(match.group('start'), 16)
            vmid = match.group('vmid')
            if started <= since or not vmid:
                continue
            if vmid not in newest or started > newest[vmid][0]:
                newest[vmid] = (started, match.group('action'))
    return {vmid: action for vmid, (_, action) in newest.items()}


def save(clean_shutdown=False):
    guests = running()
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text('\n'.join(guests) + '\n')
    if clean_shutdown:
        CLEAN_SHUTDOWN.touch()
    else:
        # The host is still up for a periodic snapshot: drop any marker left
        # by an interrupted restore so it cannot mislead a later one.
        CLEAN_SHUTDOWN.unlink(missing_ok=True)
    print('saved:', ' '.join(guests) if guests else '(none)')


def restore():
    if not STATE.exists():
        print('no saved state; nothing to restore')
        return
    clean_shutdown = CLEAN_SHUTDOWN.exists()
    CLEAN_SHUTDOWN.unlink(missing_ok=True)
    up = set(running())
    if clean_shutdown:
        # The host itself was shut down/rebooted on purpose: every qmshutdown
        # after the snapshot is pve-guests' stopall, not an operator stopping
        # that one guest by hand. Trust the saved set outright.
        later = {}
    else:
        # The snapshot's mtime is the moment reality was last observed.
        later = last_power_action(STATE.stat().st_mtime)
    for vmid in STATE.read_text().split():
        if vmid in up:
            continue
        action = later.get(vmid)
        if action in STOPPING:
            print(f'skip {vmid}: {action} after the last snapshot')
            continue
        result = subprocess.run(['qm', 'start', vmid], capture_output=True, text=True)
        print(f'start {vmid}: rc={result.returncode} {result.stderr.strip()}')


if __name__ == '__main__':
    command = sys.argv[1] if len(sys.argv) > 1 else ''
    if command == 'save':
        save()
    elif command == 'save-shutdown':
        save(clean_shutdown=True)
    elif command == 'restore':
        restore()
    else:
        raise SystemExit(__doc__)
