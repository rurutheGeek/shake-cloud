#!/bin/sh
# Ansible（monitoring_backup）が置く。K11 の鍵は authorized_keys の command= でこれしか実行できない。
# 最新の写しを tar で標準出力へ流す（圧縮は K11 がする）。
set -eu
latest=$(ls -1d {{ monitoring_backup_local_dir }}/*Z 2>/dev/null | sort | tail -n 1)
[ -n "$latest" ] || { echo "no backup yet" >&2; exit 1; }
exec tar -C "$(dirname "$latest")" -cf - "$(basename "$latest")"
