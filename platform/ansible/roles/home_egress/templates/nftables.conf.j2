# shakeserver: LAN からは入れる。シャケサーバから LAN へは出ない。
# 返信（established）と、ゲートウェイの DNS・DHCP・NTP・ping だけ通す。
# ルータの管理画面（80/443）と SSH へは出さない。tailnet とインターネットは
# この ruleset の外なのでそのまま。
# flush ruleset は使わない（Docker の nft テーブルまで消えてしまう）。
table inet homeguard {
  chain lan {
    ip daddr {{ home_egress_gateway }} meta l4proto { tcp, udp } th dport 53 accept
    ip daddr {{ home_egress_gateway }} udp dport { 67, 123 } accept
    ip daddr {{ home_egress_gateway }} icmp type echo-request accept
    ip daddr {{ home_egress_lan }} drop
    # 近隣探索とルータ要請は IPv6 が動くために要る（リンクローカル宛でも通す）
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept
    ip6 daddr fe80::/10 drop
{% if home_egress_ipv6_prefix %}
    ip6 daddr {{ home_egress_ipv6_prefix }} drop
{% endif %}
  }

  chain output {
    type filter hook output priority 0; policy accept;
    ct state established,related accept
    jump lan
  }

  # コンテナ（Docker）から LAN へ出る通信も同じ規則で落とす
  chain forward {
    type filter hook forward priority 0; policy accept;
    ct state established,related accept
    jump lan
  }
}
