# 低電池でホストを安全に止める（upsmon primary）。停止順は docs/operations/power.md。
# SHUTDOWNCMD は root で実行される。UPS が別のホストなら secondary、直結なら primary。
RUN_AS_USER nut
{% if pve_nut_server %}
MONITOR {{ pve_nut_ups_name }}@{{ pve_nut_server }} 1 {{ pve_nut_secondary_user }} {{ (pve_nut_secrets.stdout | from_json).NUT_UPSMON_PASSWORD }} secondary
{% else %}
MONITOR {{ pve_nut_ups_name }}@localhost 1 {{ pve_nut_upsmon_user }} {{ (pve_nut_secrets.stdout | from_json).NUT_UPSMON_PASSWORD }} primary
{% endif %}
MINSUPPLIES 1
SHUTDOWNCMD "{{ pve_nut_shutdown_script }}"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
{% if not pve_nut_server %}
POWERDOWNFLAG /etc/killpower
{% endif %}
NOTIFYFLAG ONBATT SYSLOG+WALL
NOTIFYFLAG LOWBATT SYSLOG+WALL
NOTIFYFLAG ONLINE SYSLOG
