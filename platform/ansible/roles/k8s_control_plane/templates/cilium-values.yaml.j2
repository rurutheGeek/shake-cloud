# Cilium の値。cp 上でテンプレートから生成する。
# kube-proxy を置かず、Cilium が Service を担う。kubeadm init を
# --skip-phases=addon/kube-proxy で実行するのと対になっている。
cluster:
  name: shakecloud
kubeProxyReplacement: true
k8sServiceHost: {{ k8s_control_plane_address }}
k8sServicePort: 6443
# Pod の CIDR は kube-controller-manager が配る（kubeadm の podSubnet）。
ipam:
  mode: kubernetes
# HTTP の入口は Cilium 自身が処理する（Ingress）。MetalLB が IP を配るので、
# DNS を固定できるよう .241 を指定する。
ingressController:
  enabled: true
  service:
    annotations:
      metallb.universe.tf/loadBalancerIPs: 192.168.10.241
