#!/bin/sh
# 5分ごとに main と、CI がビルドしたイメージ（ayahuya）を見て、変わっていたら作り直す。
# 旧ホスト向けの CD（アプリ側の deploy.yml → shake-infra）の代わりに、
# 配備先（shakeserver）が自分で取りに行く方式（UBSLEEPY と同じ）。
set -eu
cd {{ shake_web_project_dir }}

fetched=$(python3 manage.py fetch)
echo "$fetched"
pulled=$(python3 manage.py pull)
echo "$pulled"

case "$fetched" in
    *CHANGED*) python3 manage.py sync ;;
esac
case "$fetched$pulled" in
    *CHANGED*) python3 manage.py up ;;
esac
