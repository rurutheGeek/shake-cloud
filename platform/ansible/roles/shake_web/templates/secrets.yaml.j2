# Ansible（roles/shake_web）が SOPS の秘密値から作る。`podman kube play` で
# Podman の secret として読み込み、各 Pod が secretKeyRef・secret ボリュームで使う。
{% set s = shake_web_secrets.stdout | from_json %}
apiVersion: v1
kind: Secret
metadata:
  name: shake-web-env
type: Opaque
data:
{% for key in ['DB_PASSWORD', 'SHAKE_SECRET', 'IKURA_SECRET', 'QUIZ_SECRET', 'SHAKEWEB_DB_READER_PASSWORD', 'SHAKEWEB_DB_EDITOR_PASSWORD', 'PKHACK_DB_READER_PASSWORD', 'PKHACK_DB_EDITOR_PASSWORD'] %}
  {{ key }}: {{ s[key] | b64encode }}
{% endfor %}
---
apiVersion: v1
kind: Secret
metadata:
  name: shake-web-tls
type: Opaque
data:
  cert.pem: {{ s.SHAKE_ORIGIN_CERT | b64encode }}
  key.pem: {{ s.SHAKE_ORIGIN_KEY | b64encode }}
