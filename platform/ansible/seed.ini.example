# NetBox を載せる最初の1台（core-01）。NetBox がまだ無いため動的インベントリを
# 使えない初回構築と、NetBox が落ちて動的インベントリが使えないときの復旧だけに
# 使う。platform/ansible/seed.ini へコピーして実値を入れる。
# 通常の配備は NetBox の動的インベントリ（inventory.netbox.yml）を使い、この
# ファイルと併用しない（同じホストが2つの入口から出る）。
# stacks/netbox/README.md の「NetBox本体を作る初回だけ静的なSSH指定を使用します」
# と同じ位置づけ。
[seed]
core-01 ansible_host=192.0.2.200

[seed:vars]
ansible_user=debian
ansible_python_interpreter=/usr/bin/python3
# WSL から実行する場合、/mnt/c 上の鍵は ssh に拒否される。WSL のホーム配下を指す。
ansible_ssh_private_key_file=~/.ssh/id_ed25519_pve

# NetBox 本体をこのホストへ構築する。動的インベントリはまだ使えない。
[netbox_bootstrap]
core-01 ansible_host=192.0.2.200

[netbox_bootstrap:vars]
ansible_user=debian
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/id_ed25519_pve
