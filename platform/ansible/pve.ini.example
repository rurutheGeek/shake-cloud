# Proxmox VE ホストの静的インベントリ。NetBox へ登録する前の棚卸しに使う。
# platform/ansible/pve.ini へコピーして実値を入れる。pve.ini は .gitignore 対象。
# 鍵認証で接続し、初回は手動SSHでホスト鍵を確認してから実行する。
[pve]
pve1 ansible_host=192.0.2.10

[pve:vars]
ansible_user=root
ansible_python_interpreter=/usr/bin/python3
# WSL から実行する場合、/mnt/c 上の鍵はパーミッションが緩すぎて ssh に拒否される。
# WSL のホーム配下に専用鍵を作って指定する。
#   ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519_pve
ansible_ssh_private_key_file=~/.ssh/id_ed25519_pve
