{% set defaults = lookup('ansible.builtin.file', source_dir + '/.env.example').splitlines() %}
{% set overrides = stack_env | combine({'STORAGE_ROOT': storage_root, 'LIBRARY_ROOT': library_root}) %}
{% for line in defaults %}
{% if line and not line.startswith('#') and '=' in line %}
{% set key = line.split('=', 1)[0] %}
{{ key }}={{ overrides.get(key, line.split('=', 1)[1]) }}
{% endif %}
{% endfor %}
{% for key, value in overrides.items() %}
{% if key not in (defaults | select('match', '^[A-Z_]+=') | map('regex_replace', '=.*$', '') | list) %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}
