#!/bin/sh
# MLO の親デバイス（mld0）を個人端末のブリッジへ入れる。**Flint 3 だけに要る。**
#
# GL.iNet の無線スクリプトは mld0 を、その MLO の電波に指定したネットワークの
# ブリッジへ入れる作りだが、Wi-Fi を読み込み直した直後は入らないことがある。
# 入らないと、MLO の電波につながった端末にアドレスが配られない（2026-10-14 に実測）。
[ "${ACTION:-}" = "add" ] || exit 0
[ "${INTERFACE:-}" = "mld0" ] || exit 0
[ "$(uci -q get mlo.mld0.disabled)" = "0" ] || exit 0

network=$(uci -q get wireless.wlanmld5g.network)
[ -n "$network" ] || exit 0
(
	sleep 15
	ubus call network.interface."$network" add_device '{"name":"mld0"}'
	logger -t mld-bridge "mld0 added to $network"
) >/dev/null 2>&1 </dev/null &
exit 0
