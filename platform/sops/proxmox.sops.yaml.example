# Proxmox VE への接続情報。実値を入れた版は必ず暗号化してから置きます。
#
#   cp platform/sops/proxmox.sops.yaml.example platform/sops/proxmox.sops.yaml
#   # 実値へ編集してから
#   sops --encrypt --in-place platform/sops/proxmox.sops.yaml
#
# 利用時は環境変数として渡します。ファイルへ復号しません。
#
#   sops exec-env platform/sops/proxmox.sops.yaml \
#     'terraform -chdir=platform/terraform/00-bootstrap apply'
#
# PROXMOX_VE_API_TOKEN の形式は user@realm!tokenid=UUID です。
# PROXMOX_VE_SSH_* は cloud-init snippet の投入にだけ使います。
PROXMOX_VE_ENDPOINT: https://192.0.2.10:8006/
PROXMOX_VE_API_TOKEN: terraform@pve!terraform=00000000-0000-0000-0000-000000000000
PROXMOX_VE_INSECURE: "false"
PROXMOX_VE_SSH_USERNAME: root
PROXMOX_VE_SSH_PRIVATE_KEY: ""
