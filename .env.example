# Literal values only; no shell expansions. Relative paths are relative to this project.
COMPOSE_PROJECT_NAME=media-stack
STORAGE_ROOT=./storage
LIBRARY_ROOT=./library
TZ=Asia/Tokyo
BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=8080
KAVITA_PORT=5000
NAVIDROME_PORT=4533
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1
# Match the Debian Nextcloud apache image's www-data UID/GID.
MEDIA_UID=33
MEDIA_GID=33
# Initial candidates. Run `python3 scripts/stack.py lock` to pin pulled digests.
NEXTCLOUD_IMAGE=nextcloud:33-apache
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
KAVITA_IMAGE=ghcr.io/kareadita/kavita:latest
NAVIDROME_IMAGE=deluan/navidrome:latest
VAULTWARDEN_PORT=8222
VAULTWARDEN_DOMAIN=http://localhost:8222
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_IMAGE=vaultwarden/server:latest
CADDY_IMAGE=caddy:2-alpine
