COMPOSE_PROJECT_NAME=cloud
POSTGRES_IMAGE=postgres:18-alpine
STORAGE_ROOT=./storage
BIND_ADDRESS=0.0.0.0
API_PORT=8080
# ブラウザが開く入口。Authentik に登録した redirect URI は、これに /auth/callback を足したもの。
PUBLIC_URL=http://localhost:8080
# Authentik の OIDC issuer。末尾の / まで一致させる。
OIDC_ISSUER=http://localhost:9000/application/o/cloud/
# Proxmox と NetBox の接続先。トークンは SOPS から secrets/ へ写される。
PROXMOX_URL=https://localhost:8006
PROXMOX_INSECURE=true
NETBOX_URL=http://localhost:8000
# Garage（S3互換ストレージ）。管理APIのトークンは SOPS から secrets/ へ写される。
# 空ならバケット系のエンドポイントは 503 になる。
GARAGE_ADMIN_URL=http://192.168.10.206:3903
GARAGE_S3_ENDPOINT=http://192.168.10.206:3900
GARAGE_S3_REGION=garage
