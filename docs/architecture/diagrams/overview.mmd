flowchart TB
  internet["インターネット<br/>IPv6（v6プラス・MAP-E）・IPv4"]
  onu["ONU"]
  remote["宅外の端末<br/>（Tailscale・router-01 経由）"]

  subgraph host["物理ホスト apextox（K11 / Proxmox VE）"]
    subgraph netvm["ネットワークVM（platform）"]
      router["router-01 / OpenWrt<br/>ルータ・DHCP・DNS・NDP代理"]
    end
    subgraph infra["基盤VM（platform）"]
      core01["core-01<br/>Authentik・NetBox・Caddy（HTTPSの入口）"]
      cloud01["cloud-01<br/>自作クラウド API・管理DB<br/>Garage（S3）"]
      monitor["monitor-01<br/>Prometheus・Grafana・監視"]
      k8s["k8s-cp / worker<br/>AWX・CloudNativePG・Knative"]
    end
    subgraph svcpool["サービスVM（cloud）"]
      media["media-01<br/>Nextcloud・Kavita・Navidrome・FreshRSS"]
      apps["apps-01<br/>docs・Homarr・Vaultwarden・家電<br/>CUPS・LibreSpeed・pkdb・Bot"]
      web01["web-01<br/>公開サイト（LANから隔離）"]
      game["game-01<br/>Wolf・RomM・AI（GPU）"]
    end
    subgraph devpool["開発・検証VM（cloud）"]
      dev["dev-01 / dev-02<br/>Terraform・Docker・Go"]
      probe["probe-01<br/>復元ドリル（lab・停止中）"]
    end
  end
  switch["TL-SG605"]
  aterm["Aterm（APモード・Wi-Fi）"]
  relay["negitoroserver<br/>宅外の中継機（公開サイト）"]
  outpost["たらこサーバ<br/>外から見張る"]

  internet --> onu --> router
  internet --> relay
  relay -. "tailnet" .-> web01
  outpost -. "tailnet" .-> web01
  router --> switch
  switch --> aterm
  switch --> core01
  switch --> apps
  switch --> media
  switch --> monitor
  switch --> game
  switch --> web01
  switch --> dev
  web01 -. "pkdb のみ" .-> apps
  remote -. Tailscale .-> router
  cloud01 -- "VM・S3・DB・関数を払い出す" --> svcpool
  core01 --> apps
  core01 --> media
  media --> cloud01
  monitor --> k8s
  router -. "IP台帳（予約・リース）" .-> core01
